# Cloudflare Realtime TURN (https://dash.cloudflare.com → Realtime → TURN Server).
# The API token is server-only: never expose it to the browser or commit it.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional WebSocket endpoint for online play. In local development the client
# defaults to ws://<current-host>:3001 (run `bun run dev:ws`). In production it
# defaults to the same origin (/api/party/socket), so this is only needed when
# the socket server runs on a different host.
NEXT_PUBLIC_PARTY_WS_URL=
