{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parchis Stars",
  "version": "0.1.0",
  "identifier": "com.parchisstars.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "node scripts/build-desktop.mjs",
      "cwd": "../.."
    },
    "frontendDist": "../../out",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Parchís Stars",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Parchís Stars para escritorio",
    "longDescription": "Juega al Parchís Stars sin conexión: todos los recursos van incluidos en la aplicación.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
